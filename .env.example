# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: Required for public YouTube Data API v3 queries (Outliers, Competitors, Keyword metrics, @handle lookup).
YOUTUBE_API_KEY="MY_YOUTUBE_DATA_API_V3_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Firebase Web Config overrides for custom/Vercel deployments (uses your own Google Cloud / Firebase project):
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
